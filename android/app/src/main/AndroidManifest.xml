<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- ===================================================================
         PERMISOS DE LA APP (Persona 3 - Migración a Android)
         Android exige declarar aquí todo acceso a hardware o almacenamiento.
         Los usan los plugins @capacitor/camera y @capacitor/filesystem.
         =================================================================== -->

    <!-- Permite que el WebView cargue recursos (viene por defecto con Capacitor). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- CÁMARA: necesario para que Camera.getPhoto() abra la cámara
         del dispositivo o la cámara virtual del emulador. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- IMÁGENES (Android 13 / API 33 o superior): permite leer fotos de la
         galería del dispositivo, por si se elige una foto existente. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ALMACENAMIENTO (Android 12 / API 32 o inferior): equivalente antiguo de
         READ_MEDIA_IMAGES. maxSdkVersion evita pedirlo en versiones nuevas. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ESCRITURA (Android 9 / API 28 o inferior): permite guardar la foto en el
         almacenamiento público. En versiones nuevas no hace falta porque
         Filesystem guarda en Directory.Data, la carpeta privada de la app. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Indica que la app usa cámara, pero required="false" deja instalarla
         también en dispositivos sin cámara (no la oculta en Play Store). -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
</manifest>
